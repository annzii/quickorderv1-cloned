{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "name_th": {
      "type": "string",
      "title": "Name (Thai)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "description_th": {
      "type": "string",
      "title": "Description (Thai)"
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "category_th": {
      "type": "string",
      "title": "Category (Thai)"
    },
    "stock_status": {
      "type": "string",
      "title": "Stock Status",
      "enum": [
        "available",
        "limited",
        "sold_out_today",
        "not_available"
      ],
      "default": "available"
    },
    "addon_group_ids": {
      "type": "array",
      "title": "Add-on Group IDs",
      "items": {
        "type": "string"
      }
    },
    "menu_tag_ids": {
      "type": "array",
      "title": "Menu Tag IDs",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "price"
  ]
}